{
  "branches": ["main"],
  "plugins": [
    "@semantic-release/commit-analyzer",
    "@semantic-release/release-notes-generator",
    [
      "@semantic-release/changelog",
      {
        "changelogFile": "CHANGELOG.md"
      }
    ],
    [
      "@semantic-release/exec",
      {
        "prepareCmd": "sed -i -E 's/^version = \".*\"/version = \"${nextRelease.version}\"/' app/bg-zammad-mcp/pyproject.toml && sed -i -E 's|^LABEL org.opencontainers.image.version=\".*\"|LABEL org.opencontainers.image.version=\"${nextRelease.version}\"|' app/bg-zammad-mcp/Dockerfile"
      }
    ],
    [
      "@semantic-release/git",
      {
        "assets": [
          "CHANGELOG.md",
          "app/bg-zammad-mcp/pyproject.toml",
          "app/bg-zammad-mcp/Dockerfile"
        ],
        "message": "chore(release): ${nextRelease.version}\n\n${nextRelease.notes}"
      }
    ],
    "@semantic-release/github"
  ]
}
