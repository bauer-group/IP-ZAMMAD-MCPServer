# =============================================================================
# Zammad MCP Server — Environment Configuration
# =============================================================================
# Remote MCP server bridging a self-hosted Zammad 7.x helpdesk to
# AI clients (Claude Web, Claude Desktop, Microsoft 365 Copilot, ChatGPT,
# Cursor, ...).
#
# - Inbound (AI client -> MCP):  OAuth 2.1 + PKCE via Zammad (or external OIDC)
# - Outbound (MCP -> Zammad):    user's bearer token (zammad mode) or
#                                static ZAMMAD_API_TOKEN (oidc / none modes)
#
# /!\ BEFORE FIRST START - replace EVERY value containing "CHANGE_ME" /!\
#
# One-shot, cross-platform (Windows / Linux / macOS):
#
#     python scripts/generate-env.py
#
# Deployment:
#   Local development:   docker compose -f docker-compose.development.yml up -d
#   Self-hosted Traefik: docker compose -f docker-compose.traefik.yml      up -d
#   Coolify:             configure env in dashboard -> docker-compose.coolify.yml
# =============================================================================


# =============================================================================
# Stack Configuration
# =============================================================================

STACK_NAME=bg-zammad-mcp
TIME_ZONE=Etc/UTC

# production | staging | development
# AUTH_MODE=none is only permitted when ENVIRONMENT=development.
ENVIRONMENT=production


# =============================================================================
# Image
# =============================================================================

# ZAMMAD_MCP_VERSION is THIS SERVER's version. It is not Zammad's, and the two
# numbers are unrelated — a 5.x server talks to a Zammad 7.x backend. The name
# reads like "the Zammad version" at a glance, so: the supported helpdesk is
# always Zammad 7.x, whatever number stands here. `get_zammad_version` reports
# the live patch level of your actual instance.
#
# Available tags: `latest`, `stable`, a major line (5), a minor line (5.0), or
# an exact version (5.0.2). `latest` is the default and is fine — this is our
# own image and we control when it ships. Pin only if you have a reason to.
ZAMMAD_MCP_IMAGE=ghcr.io/bauer-group/ip-zammad-mcpserver/bg-zammad-mcp
ZAMMAD_MCP_VERSION=latest

# Redis (OAuth client storage - required in production for restart-safe sessions)
REDIS_IMAGE=redis
REDIS_VERSION=8-alpine

# Redis memory caps - SAFETY LIMITS, not reservations. The actual OAuth
# working set is tiny (a few KB per registered DCR client, plus issued tokens).
REDIS_MAXMEMORY=256mb
REDIS_CONTAINER_MEM_LIMIT=384m


# =============================================================================
# Hostnames & URLs (Traefik / Coolify only)
# =============================================================================

# Public hostname of the MCP server - Let's Encrypt resolves this for HTTPS.
# Give it its own name next to the Zammad it serves rather than a path on the
# same host: the OAuth callback, the protected-resource metadata and the
# consent screen all live at this origin, and sharing an origin with Zammad
# would put two different OAuth roles behind one certificate and one cookie
# scope. The pairing we run:
#
#   Zammad   support.bauer-group.com
#   MCP      mcp.support.bauer-group.com
ZAMMAD_MCP_HOSTNAME=zammad-mcp.example.com

# External Traefik network name (must already exist on the Docker host)
PROXY_NETWORK=EDGEPROXY

# Full public base URL - used in OAuth redirect URIs and protected-resource
# metadata. MUST exactly match what your IdP has registered (case, scheme,
# trailing slash).
PUBLIC_BASE_URL=https://${ZAMMAD_MCP_HOSTNAME}


# =============================================================================
# Local Ports (development only)
# =============================================================================

# Host port for the development compose file. Deliberately NOT 8080: Zammad's
# own nginx publishes on 8080, so a shared dev host would refuse to start.
ZAMMAD_MCP_PORT=8000

# Redis port exposure (development convenience - leave empty to keep redis internal)
REDIS_PORT=6379


# =============================================================================
# Zammad Backend (REQUIRED, used for every outbound call)
# =============================================================================
# Configure ZAMMAD_URL. This server targets Zammad 7.x only.
# Use the get_zammad_version tool to read the live patch level.
#
# Examples:
#   http://zammad:3000                       (same Docker network as Zammad)
#   https://support.bauer-group.com          (public Zammad instance)
ZAMMAD_URL=http://zammad:3000

# Static Zammad API token (Personal Access Token). Required in oidc / none
# AUTH_MODE. In zammad mode this MUST be empty and the server refuses to boot
# otherwise: the per_user_token resolver would fall back to it whenever a
# per-user token is missing (logging auth.obo_missing_per_user_token_falling_
# back_to_static at WARNING) and run those calls as this token's owner instead
# of the calling user, defeating per-user OBO. Override only with
# MCP_ALLOW_STATIC_FALLBACK=true, and only if you accept that.
# Generate in Zammad: avatar menu -> Profile -> Token Access -> Create.
# Suggested permissions: ticket.agent + user.reader  (or full admin for
# automation-only deployments).
ZAMMAD_API_TOKEN=

# Escape hatch for the guard above: allows ZAMMAD_API_TOKEN to coexist with
# AUTH_MODE=zammad. Leave false. Only relevant if you deliberately want tool
# calls to continue under a shared identity when a per-user token is missing.
MCP_ALLOW_STATIC_FALLBACK=false

# Extensions catalogue: operator-editable prompts (reusable agent workflows
# such as "review my queue" or "draft a customer reply") and read-only
# resources (zammad://ticket_states, .../macros, ...). The image ships a
# default at /app/extensions/extensions.json; point this elsewhere, or mount
# over that path, to customise without rebuilding. Optional - the server
# starts without it.
EXTENSIONS_CONFIG_PATH=file:///app/extensions/extensions.json

# Per-request timeout to Zammad (seconds)
ZAMMAD_HTTP_TIMEOUT=30

# Verify Zammad's TLS certificate. Only set to false for self-signed dev
# instances - never in production.
ZAMMAD_VERIFY_TLS=true


# =============================================================================
# MCP Server
# =============================================================================

# Transport - only 'streamable-http' makes sense for a remote MCP server.
MCP_TRANSPORT=streamable-http

# Bind address. Leave empty for dual-stack on any interface (default).
MCP_HOST=

# Port INSIDE the container. 8080 is the conventional HTTP-alternate port and
# is safe here because a container has its own network namespace - Zammad's own
# 8080 cannot clash with it. What reaches the host is ZAMMAD_MCP_PORT above,
# which stays 8000 precisely so a dev box can run Zammad and this side by side.
MCP_PORT=8080

# Log format: console (dev, Rich-coloured) or json (prod, aggregator-friendly)
LOG_FORMAT=json
LOG_LEVEL=INFO


# =============================================================================
# Consent screen branding (OAuth dialog shown to end users)
# =============================================================================
# These three values appear on the FastMCP OAuth consent screen — the dialog
# AI clients (Claude, Microsoft 365 Copilot, ...) render before exchanging the
# first authorization code. Override to rebrand a deployment without forking.
#
# MCP_DISPLAY_NAME   - friendly server name ("...wants to access the MCP server
#                      <name>"). Plain text, NOT the internal identifier.
# MCP_ICON_URL       - absolute URL to the icon. Leave empty to serve the
#                      bundled BAUER GROUP logo at ${PUBLIC_BASE_URL}/logo.svg.
# MCP_WEBSITE_URL    - hyperlink behind the server name. Set to empty to
#                      disable the link.

MCP_DISPLAY_NAME=BAUER GROUP Zammad
MCP_ICON_URL=
MCP_WEBSITE_URL=https://go.bauer-group.com/mcp-server


# =============================================================================
# Auth Mode - pick ONE
# =============================================================================
# Valid:
#   zammad - Zammad IS the OAuth2 provider (PRIMARY, recommended).
#            User-context: the user's Zammad access token is forwarded to
#            every API call, so Zammad's permission system enforces access.
#   oidc   - External OIDC IdP (Entra / Keycloak / Authentik / Zitadel /
#            Auth0 / Okta) handles authentication. Zammad calls use the
#            static ZAMMAD_API_TOKEN (single Zammad identity for every user).
#   none   - Dev only. Requires ENVIRONMENT=development. Uses ZAMMAD_API_TOKEN.

AUTH_MODE=zammad


# =============================================================================
# Auth: Zammad as OAuth2 provider  (AUTH_MODE=zammad)
# =============================================================================
# Operator setup (one-time, in Zammad):
#   1. Sign in to Zammad as an Admin
#   2. Admin -> System -> API        (page #system/api, permission admin.api)
#   3. Section "Applications" -> "New Application". The form has exactly two
#      fields - there is no scope field and no confidential toggle:
#        Name:          BAUER GROUP MCP   (or your preferred display name)
#        Callback URL:  ${PUBLIC_BASE_URL}/auth/callback
#      NOTE: the callback URL must be HTTPS. A production-mode Zammad refuses
#      to save the application with an http:// URL, so PUBLIC_BASE_URL has to
#      be https:// for AUTH_MODE=zammad.
#   4. Save, then use the row's "View" action to read the Client ID and
#      Client Secret. Both stay retrievable - this is not a one-time reveal.
#
# Requires Zammad 7.x (see ZAMMAD_URL above).

ZAMMAD_OAUTH_CLIENT_ID=
ZAMMAD_OAUTH_CLIENT_SECRET=

# Scope requested during the consent flow. Zammad runs plain Doorkeeper with
# `default_scopes :full` and no optional scopes, and the application form never
# sets a per-app scope - so 'full' is the ONLY accepted value. Anything else
# (the intuitive 'read write', for instance) is rejected with invalid_scope
# after the user has already logged in. The server validates this at boot.
ZAMMAD_OAUTH_SCOPES=full

# Endpoint paths - overridable only when Zammad is mounted on a non-default path
# (reverse proxy with a sub-path). Leave defaults otherwise.
ZAMMAD_OAUTH_AUTHORIZE_PATH=/oauth/authorize
ZAMMAD_OAUTH_TOKEN_PATH=/oauth/token
ZAMMAD_USERINFO_PATH=/api/v1/users/me


# =============================================================================
# Auth: External OIDC (Entra / Keycloak / Authentik / ...)  (AUTH_MODE=oidc)
# =============================================================================
# Redirect URI to register with the IdP: ${PUBLIC_BASE_URL}/auth/callback
#
# Either set OIDC_DISCOVERY_URL and the loader pulls endpoints automatically,
# or set each OIDC_*_URI explicitly. Discovery is preferred - it picks up
# JWKS rotations transparently.

OIDC_DISCOVERY_URL=
# Example: OIDC_DISCOVERY_URL=https://id.bauer-group.com/application/o/zammad-mcp/.well-known/openid-configuration

OIDC_ISSUER=
OIDC_AUTH_URI=
OIDC_TOKEN_URI=
OIDC_JWKS_URI=
OIDC_USERINFO_URI=

OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=

OIDC_SCOPES=openid profile email
OIDC_USERNAME_CLAIM=preferred_username


# =============================================================================
# Role-based MCP access
# =============================================================================
# Which Zammad role names may use this MCP at all. Case-insensitive,
# comma-separated.
#
# Common configurations:
#   Admin,Agent             - Internal MCP for agents and admins (DEFAULT)
#   Admin                   - Admins only (highly privileged automation)
#   Customer                - Self-service MCP for customers
#   Admin,Agent,Customer    - Anyone with a Zammad account (review carefully)
#
# Leave empty to allow ANY authenticated Zammad user. NOT recommended in
# production because customer accounts can be self-registered in some setups.
#
# Only enforced in AUTH_MODE=zammad - external OIDC tokens don't carry
# Zammad role info, so this is a no-op in AUTH_MODE=oidc/none. Zammad's own
# permission system enforces fine-grained access in every mode.
MCP_ALLOWED_ROLES=Admin,Agent

# Seconds to cache a SUCCESSFUL token verification (and with it the caller's
# role set). Zammad issues opaque tokens, so every MCP request would otherwise
# cost a /api/v1/users/me round trip - a ten-tool Claude turn is ten of them.
# Trade-off: a revoked token, a deactivated user or a role change takes up to
# this long to take effect. Failures are never cached, so a rejection is always
# live. 0 = verify against Zammad on every request.
MCP_ROLE_CACHE_TTL_SECONDS=30

# Redirect-URI allowlist for dynamically-registered MCP clients (RFC 7591).
#
# LEAVE THIS EMPTY unless you have a reason not to. Dynamic registration
# exists because a server cannot know its clients in advance, so listing
# vendor callback URLs here locks the server to the agents that happened to be
# known when it was configured - Claude, ChatGPT, Copilot, Cursor, Continue and
# anything built next all use different callbacks, and ChatGPT does not use DCR
# at all. An empty value keeps the server usable from any MCP-capable client.
#
# What still protects you with it empty: the consent screen names the client
# and its redirect target before any token is issued, MCP_ALLOWED_ROLES decides
# who may use the server at all, every call runs with that user's own Zammad
# permissions, and writes are audit-logged.
#
# Set it only if your client set is fixed and you want defence in depth against
# a user being talked into approving an attacker-registered client. A trailing
# * is a wildcard; the MCP spec requires loopback or HTTPS. Example:
#   MCP_ALLOWED_CLIENT_REDIRECT_URIS=https://claude.ai/api/mcp/auth_callback,https://claude.com/api/mcp/auth_callback,http://localhost:*,http://127.0.0.1:*
MCP_ALLOWED_CLIENT_REDIRECT_URIS=

# Audit-only mode: role denials are logged but the request is allowed
# through. Use during rollout to verify the allowlist matches reality
# before switching to enforcement.
MCP_ROLE_CHECK_AUDIT_ONLY=false


# =============================================================================
# OAuth Persistence
# =============================================================================
# OAuth state (DCR clients, refresh tokens, auth codes, JTI mappings + the
# upstream Zammad tokens we forward at tool-call time) must survive
# container restarts - otherwise every client re-registers and every user
# re-authenticates after a deploy.
#
# Two backends, both encrypted at rest:
#   - Redis-backed (recommended for production):
#       AUTH_REDIS_URL=redis://redis:6379/0
#       AUTH_STORAGE_ENCRYPTION_KEY=<fernet-key>   (operator-controlled)
#   - Disk-backed (fallback when no Redis is available):
#       AUTH_REDIS_URL=                            (empty)
#       AUTH_DISK_STORAGE_PATH=/app/data/oauth-storage
#       Encryption key is derived from AUTH_JWT_SIGNING_KEY via HKDF.
#       MOUNT THE PATH AS A DOCKER VOLUME, otherwise state is wiped on every
#       container restart.

# JWT signing key — used to sign FastMCP-issued tokens AND (in disk mode) to
# derive the storage encryption key. Must survive restarts.
#   openssl rand -hex 32
AUTH_JWT_SIGNING_KEY=CHANGE_ME_AUTH_JWT_SIGNING_KEY

# Redis URL for OAuth client-registration storage. Leave empty to use the
# encrypted disk-storage fallback at AUTH_DISK_STORAGE_PATH.
AUTH_REDIS_URL=redis://redis:6379/0

# Fernet key for at-rest encryption of stored OAuth state in Redis mode.
# REQUIRED when AUTH_REDIS_URL is set; ignored in disk mode.
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
AUTH_STORAGE_ENCRYPTION_KEY=CHANGE_ME_AUTH_STORAGE_ENCRYPTION_KEY

# Filesystem path for the encrypted disk-storage fallback.
AUTH_DISK_STORAGE_PATH=/app/data/oauth-storage


# =============================================================================
# Attachments
# =============================================================================
# All byte limits measure DECODED bytes. Base64 inflates by 4/3, so a limit on
# the encoded payload would pass only three quarters of its nominal value.
# Zammad's own request-body limit applies to the INFLATED size, so keep the
# article limit comfortably below it (25 MiB payload is roughly 33 MiB body).

# Reading: default and hard ceiling for download_ticket_attachment's max_bytes.
# The ceiling exists because a model that hits the default simply retries with
# a bigger number; it must be >= the default.
ZAMMAD_ATTACHMENT_MAX_READ_BYTES=5242880
ZAMMAD_ATTACHMENT_READ_CEILING_BYTES=20971520

# Writing: set to false to remove the `attachments` parameter from
# reply_to_customer, add_internal_note and create_ticket entirely. The
# parameter disappears from the published schema rather than failing at call
# time, so a client never discovers the restriction by trying it.
ZAMMAD_ATTACHMENT_UPLOAD_ENABLED=true

# Per file, and per article across all of its files. The article limit must be
# >= the per-file limit.
ZAMMAD_ATTACHMENT_MAX_UPLOAD_BYTES=10485760
ZAMMAD_ATTACHMENT_MAX_ARTICLE_BYTES=26214400


# =============================================================================
# Rate Limiting
# =============================================================================
# Token-bucket limiter applied on every MCP request - cheapest rejection
# path under load. Keyed per-client when possible:
#   - authenticated requests  -> OAuth subject (`sub` / Entra `oid`)
#   - anonymous requests      -> source IP (X-Forwarded-For, see below)
#   - stdio transport         -> single shared bucket "ip:local"

RATE_LIMITER_ENABLED=true
RATE_LIMITER_MAX_REQUESTS_PER_SECOND=10
RATE_LIMITER_BURST_CAPACITY=20
RATE_LIMITER_GLOBAL=false

# Number of trusted reverse-proxy hops in front of this server.
#   0  - No proxy. XFF is ignored; request.client.host is used.
#   1  - Direct Traefik / Coolify default. (DEFAULT)
#   2  - Cloudflare -> Traefik. Or any 2-hop edge -> ingress chain.
RATE_LIMITER_TRUSTED_PROXY_HOPS=1


# =============================================================================
# Observability
# =============================================================================
# Sentry error tracking (optional - leave SENTRY_DSN empty to disable)

SENTRY_DSN=
SENTRY_ENVIRONMENT=${ENVIRONMENT}
SENTRY_TRACES_SAMPLE_RATE=0.05
